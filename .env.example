# Copy to .env and restart Start_Suite.bat after changing values.
# These selected fields are PUBLIC on the website, but stay out of Git.
# Leave a field empty to hide that contact or payment method.

# International format: country code + area code + number, digits only.
CONTACT_WHATSAPP=
CONTACT_EMAIL=
CONTACT_WEBSITE=
CONTACT_INSTAGRAM=
CONTACT_YOUTUBE=

# Use an HTTPS payment/donation page, or configure a Pix key below.
DONATION_URL=
PIX_KEY=
PIX_RECIPIENT_NAME=
PIX_RECIPIENT_CITY=
PIX_BANK_NAME=

# Optional public source-code link.
PROJECT_REPOSITORY_URL=

# Optional conversion engine. An installed/extracted engine is also detected.
LIBREOFFICE_PATH=
